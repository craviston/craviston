rules_version = '2';

/**
 * Craviston Waffle Snake - Firestore security rules
 *
 * Collections
 *   scores/{uid}  { uid, name, score, achievedAt }
 *                  One document per player. Written by the player, read by everyone.
 *   players/{uid} { uid, name, email, eligible, lastLogin }
 *                  Private profile data. Only the owner can read or write it.
 *
 * Deploy with:  firebase deploy --only firestore:rules,firestore:indexes
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // Hard ceiling on a single score. The game awards 10 points per waffle,
    // so 5000 is far beyond any legitimate run.
    function maxScore() {
      return 5000;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---- Public leaderboard -------------------------------------------------
    match /scores/{uid} {
      // Anyone may read the board, including the signed-out landing view.
      allow get, list: if true;

      // A player may create their own entry only.
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 32
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= maxScore();

      // A player may raise their own score but never lower, rename to
      // something longer, or rewrite someone else's entry.
      allow update: if isOwner(uid)
        && resource.data.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 32
        && request.resource.data.score is int
        && request.resource.data.score <= maxScore()
        && request.resource.data.score >= resource.data.score;

      // Scores are permanent so ties can be broken by who reached them first.
      allow delete: if false;
    }

    // ---- Private player profile --------------------------------------------
    match /players/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
